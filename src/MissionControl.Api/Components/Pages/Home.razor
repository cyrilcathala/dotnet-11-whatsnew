@page "/"
@rendermode InteractiveServer

<PageTitle>Mission Control</PageTitle>

<section class="launch @(_secondsLeft == 0 ? "lifted" : null)">
    <div class="intro">
        <h1>Bienvenue au centre de contrôle de mission</h1>
        <p>Ici, on enregistre des sondes, on leur envoie des commandes et on suit leur télémétrie.</p>
    </div>

    <div class="countdown">
        <p class="clock" role="status">@CountdownLabel</p>
        <ol class="sequence" aria-hidden="true">
            @for (var second = Start; second > 0; second--)
            {
                <li class="@(second > _secondsLeft ? "elapsed" : null)"></li>
            }
        </ol>
        <button class="btn" @onclick="Tick" disabled="@(_secondsLeft == 0)">Compte à rebours</button>
    </div>
</section>

<nav class="stations" aria-label="Stations de la mission">
    <a href="sondes"><strong>Flotte</strong><span>Enregistrer une sonde et sa fenêtre de lancement.</span></a>
    <a href="commandes"><strong>Commandes</strong><span>Poussée, rotation, photo… ou autodestruction.</span></a>
</nav>

@code {
    private const int Start = 10;

    private int _secondsLeft = Start;

    private string CountdownLabel => _secondsLeft == 0 ? "Décollage !" : $"T-{_secondsLeft}";

    private void Tick() => _secondsLeft = Math.Max(0, _secondsLeft - 1);
}
